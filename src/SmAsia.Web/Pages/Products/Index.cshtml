@page
@model SmAsia.Web.Pages.Products.IndexModel
@{
    ViewData["Title"] = "Products";
    var pages = (int)Math.Ceiling(Model.Total / (double)SmAsia.Web.Pages.Products.IndexModel.PageSize);
}

<div class="page-head">
    <div><h1>Products</h1><div class="sub">@Model.Total.ToString("N0") products</div></div>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-secondary" href="@Url.Page("Index", "Export", new { Model.Q, Model.CategoryId, Model.SupplierId, Model.Location, Model.Filter, Model.Sort })"><i class="bi bi-file-earmark-excel"></i> Export count sheet</a>
        <a class="btn btn-primary" href="/products/edit"><i class="bi bi-plus-lg"></i> New product</a>
    </div>
</div>

<div class="card mb-3"><div class="card-body py-2">
    <form method="get" class="filters">
        <input name="q" value="@Model.Q" class="form-control form-control-sm" placeholder="Name, barcode or supplier code" style="min-width:220px" />
        <select name="categoryId" class="form-select form-select-sm">
            <option value="">All categories</option>
            @foreach (var c in Model.Categories) { <option value="@c.Id" selected="@(c.Id == Model.CategoryId)">@c.Name</option> }
        </select>
        <select name="supplierId" class="form-select form-select-sm">
            <option value="">All suppliers</option>
            @foreach (var s in Model.Suppliers) { <option value="@s.Id" selected="@(s.Id == Model.SupplierId)">@s.Name</option> }
        </select>
        <select name="location" class="form-select form-select-sm">
            <option value="">All locations</option>
            @foreach (var l in Model.Locations) { <option selected="@(l == Model.Location)">@l</option> }
        </select>
        <select name="filter" class="form-select form-select-sm">
            <option value="">Any stock</option>
            <option value="out" selected="@(Model.Filter == "out")">Out of stock</option>
            <option value="low" selected="@(Model.Filter == "low")">Below minimum</option>
            <option value="expiring" selected="@(Model.Filter == "expiring")">Expiring ≤ 60 days</option>
            <option value="nobarcode" selected="@(Model.Filter == "nobarcode")">Missing barcode</option>
            <option value="nosupplier" selected="@(Model.Filter == "nosupplier")">No supplier</option>
            <option value="inactive" selected="@(Model.Filter == "inactive")">Inactive</option>
        </select>
        <select name="sort" class="form-select form-select-sm">
            <option value="name">Sort: name</option>
            <option value="category" selected="@(Model.Sort == "category")">Sort: category</option>
            <option value="location" selected="@(Model.Sort == "location")">Sort: location</option>
            <option value="qty" selected="@(Model.Sort == "qty")">Sort: on hand</option>
            <option value="expiry" selected="@(Model.Sort == "expiry")">Sort: expiry</option>
        </select>
        <button class="btn btn-sm btn-primary">Filter</button>
        <a class="btn btn-sm btn-link" href="/products">Clear</a>
    </form>
</div></div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-sm table-hover align-middle">
            <thead><tr><th>Product</th><th>Barcode</th><th>Category</th><th>Location</th><th>Supplier</th><th class="num">On hand</th><th class="num">Unit cost</th><th class="num">Price</th><th>Expiry</th><th></th></tr></thead>
            <tbody>
            @foreach (var p in Model.Items)
            {
                <tr>
                    <td><a href="/products/details/@p.Id" class="fw-semibold">@p.Name</a>@if (p.UnitsPerCase > 1) {<span class="small-muted"> · @p.UnitsPerCase/cs</span>}</td>
                    <td class="small">@p.Barcode</td>
                    <td class="small">@p.Category?.Name</td>
                    <td class="small">@p.Location</td>
                    <td class="small">@p.PreferredSupplier?.Name</td>
                    <td class="num">@Fmt.Qty(p.QtyOnHand)</td>
                    <td class="num">@(p.UnitCost > 0 ? Fmt.Money(p.UnitCost) : "—")</td>
                    <td class="num">@(p.SellPrice > 0 ? Fmt.Money(p.SellPrice) : "—")</td>
                    <td>@Fmt.Expiry(p.NearestExpiry)</td>
                    <td>@Fmt.Stock(p)</td>
                </tr>
            }
            @if (Model.Items.Count == 0)
            {
                <tr><td colspan="10" class="muted p-3">No products found. <a href="/import/inventory">Import your inventory workbook</a> or <a href="/products/edit">add a product</a>.</td></tr>
            }
            </tbody>
        </table>
    </div>
    @if (pages > 1)
    {
        <div class="card-footer d-flex justify-content-between align-items-center">
            <span class="small-muted">Page @Model.PageNo of @pages</span>
            <div class="btn-group">
                <a class="btn btn-sm btn-outline-secondary @(Model.PageNo <= 1 ? "disabled" : "")" href="@Model.PageUrl(Model.PageNo - 1)">Previous</a>
                <a class="btn btn-sm btn-outline-secondary @(Model.PageNo >= pages ? "disabled" : "")" href="@Model.PageUrl(Model.PageNo + 1)">Next</a>
            </div>
        </div>
    }
</div>
