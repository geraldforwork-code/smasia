@page "{id:int?}"
@model SmAsia.Web.Pages.Products.EditModel
@{
    var isNew = Model.Product.Id == 0;
    ViewData["Title"] = isNew ? "New product" : $"Edit {Model.Product.Name}";
}

<div class="page-head">
    <div><h1>@(isNew ? "New product" : "Edit product")</h1>@if (!isNew) {<div class="sub">@Model.Product.Name</div>}</div>
</div>

<form method="post" class="card" style="max-width: 900px">
    <div class="card-body">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <input type="hidden" asp-for="Product.Id" />
        <div class="row g-3">
            <div class="col-md-8">
                <label class="form-label" asp-for="Product.Name">Name</label>
                <input class="form-control" asp-for="Product.Name" autofocus />
                <span asp-validation-for="Product.Name" class="text-danger small"></span>
            </div>
            <div class="col-md-4">
                <label class="form-label" asp-for="Product.Barcode">Barcode (UPC/EAN)</label>
                <input class="form-control" asp-for="Product.Barcode" />
                <span asp-validation-for="Product.Barcode" class="text-danger small"></span>
            </div>
            <div class="col-md-4">
                <label class="form-label">Category</label>
                <select class="form-select" asp-for="Product.CategoryId">
                    <option value="">—</option>
                    @foreach (var c in Model.Categories) { <option value="@c.Id">@c.Name</option> }
                </select>
                <input class="form-control form-control-sm mt-1" asp-for="NewCategory" placeholder="…or type a new category" />
            </div>
            <div class="col-md-4">
                <label class="form-label" asp-for="Product.Location">Stock location</label>
                <input class="form-control" asp-for="Product.Location" placeholder="e.g. AISLE 4" />
            </div>
            <div class="col-md-4">
                <label class="form-label">Preferred supplier</label>
                <select class="form-select" asp-for="Product.PreferredSupplierId">
                    <option value="">—</option>
                    @foreach (var s in Model.Suppliers) { <option value="@s.Id">@s.Name</option> }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label" asp-for="Product.UnitsPerCase">Units per case</label>
                <input class="form-control" asp-for="Product.UnitsPerCase" type="number" min="1" />
                <span asp-validation-for="Product.UnitsPerCase" class="text-danger small"></span>
            </div>
            <div class="col-md-3">
                <label class="form-label" asp-for="Product.UnitCost">Unit cost</label>
                <input class="form-control" asp-for="Product.UnitCost" type="number" step="0.0001" min="0" />
                <div class="form-text">Updated automatically when stock is received.</div>
            </div>
            <div class="col-md-3">
                <label class="form-label" asp-for="Product.SellPrice">Selling price</label>
                <input class="form-control" asp-for="Product.SellPrice" type="number" step="0.01" min="0" />
            </div>
            <div class="col-md-3">
                <label class="form-label" asp-for="Product.MinStock">Minimum stock</label>
                <input class="form-control" asp-for="Product.MinStock" type="number" step="1" min="0" />
                <div class="form-text">Always reorder below this.</div>
            </div>
            <div class="col-md-3">
                <label class="form-label" asp-for="Product.NearestExpiry">Nearest expiry</label>
                <input class="form-control" asp-for="Product.NearestExpiry" type="date" />
            </div>
            @if (isNew)
            {
                <div class="col-md-3">
                    <label class="form-label" asp-for="OpeningStock">Opening stock (units)</label>
                    <input class="form-control" asp-for="OpeningStock" type="number" step="1" />
                </div>
            }
            else
            {
                <div class="col-md-3">
                    <label class="form-label">On hand</label>
                    <div class="form-control-plaintext">@Fmt.Qty(Model.Product.QtyOnHand) <a class="small" href="/products/details/@Model.Product.Id#adjust">adjust</a></div>
                </div>
            }
            <div class="col-md-3 d-flex align-items-end">
                <div class="form-check">
                    <input class="form-check-input" asp-for="Product.IsActive" />
                    <label class="form-check-label" asp-for="Product.IsActive">Active</label>
                </div>
            </div>
        </div>
    </div>
    <div class="card-footer d-flex gap-2">
        <button class="btn btn-primary">Save</button>
        <a class="btn btn-link" href="@(isNew ? "/products" : $"/products/details/{Model.Product.Id}")">Cancel</a>
    </div>
</form>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
