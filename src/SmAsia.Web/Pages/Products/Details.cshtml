@page "{id:int}"
@model SmAsia.Web.Pages.Products.DetailsModel
@{
    var p = Model.Product;
    ViewData["Title"] = p.Name;
    var f = Model.Forecast;
}

<div class="page-head">
    <div>
        <h1>@p.Name @if (!p.IsActive) { @Fmt.Badge("Inactive", "neutral") }</h1>
        <div class="sub">@(p.Category?.Name ?? "Uncategorised") · @(p.Location ?? "No location") · @(p.Barcode ?? "No barcode")</div>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-secondary" href="/products/edit/@p.Id"><i class="bi bi-pencil"></i> Edit</a>
        <a class="btn btn-outline-secondary" href="/purchaseorders/edit?productId=@p.Id"><i class="bi bi-cart-plus"></i> Order</a>
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-6 col-lg-3"><div class="card kpi"><div class="label">On hand</div><div class="value">@Fmt.Qty(p.QtyOnHand)</div><div class="hint">@(p.UnitsPerCase > 1 ? $"{p.QtyOnHand / p.UnitsPerCase:0.#} cases of {p.UnitsPerCase}" : "units")</div></div></div>
    <div class="col-6 col-lg-3"><div class="card kpi"><div class="label">Unit cost / price</div><div class="value">@Fmt.Money(p.UnitCost)</div><div class="hint">sells for @Fmt.Money(p.SellPrice)@(p.SellPrice > 0 && p.UnitCost > 0 ? $" · margin {(p.SellPrice - p.UnitCost) / p.SellPrice:P0}" : "")</div></div></div>
    <div class="col-6 col-lg-3"><div class="card kpi"><div class="label">Avg daily demand</div><div class="value">@(f != null ? f.Forecast.DailyRate.ToString("0.##") : "—")</div><div class="hint">@(f?.Forecast.Method) · sold @(f != null ? Fmt.Qty(f.Forecast.Sold28) : "0") in 28 days</div></div></div>
    <div class="col-6 col-lg-3"><div class="card kpi"><div class="label">Days of cover</div><div class="value">@(f?.Advice.DaysOfCover is { } dc ? dc.ToString("0") : "—")</div><div class="hint">@(f?.Advice.StockoutDate is { } so ? $"runs out ~{Fmt.Date(so)}" : "no stock-out forecast")</div></div></div>
</div>

<div class="row g-3">
    <div class="col-xl-8">
        <div class="card mb-3">
            <div class="card-header">Weekly units sold &amp; forecast</div>
            <div class="card-body">
                @if (Model.WeeklySales.Count == 0)
                {
                    <p class="muted mb-0">No sales imported yet.</p>
                }
                else
                {
                    <canvas id="chart" height="100"></canvas>
                }
            </div>
        </div>

        <div class="card">
            <div class="card-header">Stock movements</div>
            <div class="table-responsive" style="max-height: 460px">
                <table class="table table-sm">
                    <thead><tr><th>Date</th><th>Type</th><th>Reference</th><th class="num">Change</th><th class="num">Balance</th><th class="num">Unit cost</th></tr></thead>
                    <tbody>
                    @foreach (var m in Model.Movements)
                    {
                        <tr>
                            <td class="small">@m.OccurredAt.ToString("g")</td>
                            <td>@m.Type</td>
                            <td class="small">@if (m.ReceiptId != null) {<a href="/receiving/edit/@m.ReceiptId">@m.Reference</a>} else if (m.ImportBatchId != null) {<a href="/import/batch/@m.ImportBatchId">@m.Reference</a>} else {@m.Reference} <span class="muted">@m.Note</span></td>
                            <td class="num @Fmt.MovementClass(m.Quantity)">@(m.Quantity > 0 ? "+" : "")@Fmt.Qty(m.Quantity)</td>
                            <td class="num">@Fmt.Qty(m.QtyAfter)</td>
                            <td class="num">@(m.UnitCost != null ? Fmt.Money(m.UnitCost.Value) : "")</td>
                        </tr>
                    }
                    @if (Model.Movements.Count == 0) { <tr><td colspan="6" class="muted">No movements yet.</td></tr> }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="col-xl-4">
        <div class="card mb-3" id="adjust">
            <div class="card-header">Adjust stock</div>
            <form method="post" asp-page-handler="Adjust" asp-route-id="@p.Id" class="card-body">
                <div class="mb-2">
                    <select class="form-select" asp-for="Adjust.Type">
                        <option value="Count">Set counted quantity</option>
                        <option value="Adjustment">Add / remove (±)</option>
                        <option value="Wastage">Write off (damaged / expired)</option>
                    </select>
                </div>
                <div class="mb-2"><input class="form-control" asp-for="Adjust.Quantity" type="number" step="any" placeholder="Quantity (units)" required /></div>
                <div class="mb-2"><input class="form-control" asp-for="Adjust.Note" placeholder="Note (optional)" /></div>
                <button class="btn btn-primary w-100">Update stock</button>
            </form>
        </div>

        @if (f != null)
        {
            <div class="card mb-3">
                <div class="card-header">Reorder calculation</div>
                <table class="table table-sm">
                    <tr><td>Supplier</td><td class="num">@(f.Supplier?.Name ?? "—")</td></tr>
                    <tr><td>Lead time</td><td class="num">@f.LeadTimeDays days</td></tr>
                    <tr><td>On order</td><td class="num">@Fmt.Qty(f.OnOrder)</td></tr>
                    <tr><td>Safety stock</td><td class="num">@Fmt.Qty(f.Advice.SafetyStock)</td></tr>
                    <tr><td>Reorder point</td><td class="num">@Fmt.Qty(f.Advice.ReorderPoint)</td></tr>
                    <tr><td>Order up to</td><td class="num">@Fmt.Qty(f.Advice.TargetLevel)</td></tr>
                    <tr><td>Trend</td><td class="num">@(f.Forecast.Trend is { } t ? t.ToString("+0%;-0%") + " / week" : "—")</td></tr>
                    <tr class="fw-semibold"><td>Suggested order</td><td class="num">@(f.Advice.SuggestedCases > 0 ? $"{f.Advice.SuggestedCases:0} cs ({Fmt.Qty(f.Advice.SuggestedUnits)} units)" : f.Advice.Reason)</td></tr>
                </table>
            </div>
        }

        @if (Model.OpenPoLines.Count > 0)
        {
            <div class="card mb-3">
                <div class="card-header">On order</div>
                <table class="table table-sm">
                    @foreach (var l in Model.OpenPoLines)
                    {
                        <tr><td><a href="/purchaseorders/view/@l.PurchaseOrderId">@l.PurchaseOrder.PoNumber</a> <span class="small-muted">@l.PurchaseOrder.Supplier.Name</span></td><td class="num">@Fmt.Qty(l.QtyOutstandingUnits) units</td></tr>
                    }
                </table>
            </div>
        }

        <div class="card mb-3">
            <div class="card-header">Supplier item codes</div>
            <table class="table table-sm">
                @foreach (var s in Model.SupplierItems)
                {
                    <tr>
                        <td><span class="fw-semibold">@s.SupplierItemCode</span> <span class="small-muted">@s.Supplier.Name</span><div class="small-muted">@s.SupplierDescription</div></td>
                        <td class="num">@Fmt.Money(s.LastCaseCost)/cs<div class="small-muted">@s.UnitsPerCase/cs</div></td>
                        <td><form method="post" asp-page-handler="DeleteSupplierItem" asp-route-id="@p.Id" asp-route-itemId="@s.Id"><button class="btn btn-sm btn-link text-danger p-0" data-confirm="Remove this supplier code link?"><i class="bi bi-x-lg"></i></button></form></td>
                    </tr>
                }
                @if (Model.SupplierItems.Count == 0) { <tr><td class="muted">Learned automatically when an invoice is received.</td></tr> }
            </table>
        </div>

        @if (Model.Aliases.Count > 0)
        {
            <div class="card">
                <div class="card-header">EPOS aliases</div>
                <table class="table table-sm">
                    @foreach (var a in Model.Aliases)
                    {
                        <tr><td>@a.Code <span class="small-muted">@a.Name</span></td>
                            <td><form method="post" asp-page-handler="DeleteAlias" asp-route-id="@p.Id" asp-route-aliasId="@a.Id"><button class="btn btn-sm btn-link text-danger p-0"><i class="bi bi-x-lg"></i></button></form></td></tr>
                    }
                </table>
            </div>
        }
    </div>
</div>

@section Scripts {
    @if (Model.WeeklySales.Count > 0)
    {
        var labels = Model.WeeklySales.Select(w => w.Week.ToString("MMM d")).ToList();
        var forecastWeeks = f?.Forecast.WeeklyForecast.Take(8).ToArray() ?? [];
        var lastWeek = Model.WeeklySales[^1].Week;
        labels.AddRange(Enumerable.Range(1, forecastWeeks.Length).Select(i => lastWeek.AddDays(7 * i).ToString("MMM d")));
        var actual = Model.WeeklySales.Select(w => (double?)w.Units).Concat(Enumerable.Repeat<double?>(null, forecastWeeks.Length));
        var fc = Enumerable.Repeat<double?>(null, Model.WeeklySales.Count - 1).Append((double?)Model.WeeklySales[^1].Units).Concat(forecastWeeks.Select(x => (double?)Math.Round(x, 1)));
        <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
        <script>
            new Chart(document.getElementById('chart'), {
                data: {
                    labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(labels)),
                    datasets: [
                        { type: 'bar', label: 'Units sold', data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(actual)), backgroundColor: '#0f766e', borderRadius: 3 },
                        { type: 'line', label: 'Forecast', data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(fc)), borderColor: '#f59e0b', borderDash: [5, 4], pointRadius: 2, tension: .2 }
                    ]
                },
                options: { scales: { y: { beginAtZero: true } , x: { grid: { display: false } } } }
            });
        </script>
    }
}
