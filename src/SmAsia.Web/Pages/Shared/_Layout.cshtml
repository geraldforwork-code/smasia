<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · SM Asia Inventory</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    @{
        var path = Context.Request.Path.Value?.ToLowerInvariant() ?? "/";
        string Active(string prefix) => (prefix == "/" ? path == "/" : path.StartsWith(prefix)) ? "active" : "";
    }
    <div class="app">
        <nav class="sidebar d-print-none" id="sidebar">
            <a class="brand" href="/"><i class="bi bi-shop"></i> SM Asia</a>
            <div class="nav-section">Overview</div>
            <a class="nav-link @Active("/")" href="/"><i class="bi bi-speedometer2"></i> Dashboard</a>
            <div class="nav-section">Stock</div>
            <a class="nav-link @Active("/products")" href="/products"><i class="bi bi-box-seam"></i> Products</a>
            <a class="nav-link @Active("/stock/count")" href="/stock/count"><i class="bi bi-clipboard-check"></i> Stock count</a>
            <a class="nav-link @Active("/stock/movements")" href="/stock/movements"><i class="bi bi-arrow-left-right"></i> Movements</a>
            <div class="nav-section">Buying</div>
            <a class="nav-link @Active("/forecast")" href="/forecast"><i class="bi bi-graph-up-arrow"></i> Forecast &amp; reorder</a>
            <a class="nav-link @Active("/purchaseorders")" href="/purchaseorders"><i class="bi bi-cart3"></i> Purchase orders</a>
            <a class="nav-link @Active("/receiving")" href="/receiving"><i class="bi bi-truck"></i> Receiving</a>
            <a class="nav-link @Active("/suppliers")" href="/suppliers"><i class="bi bi-building"></i> Suppliers</a>
            <div class="nav-section">Data</div>
            <a class="nav-link @Active("/import")" href="/import"><i class="bi bi-cloud-upload"></i> Imports</a>
        </nav>
        <div class="main">
            <header class="topbar d-print-none">
                <button class="btn btn-sm btn-outline-secondary d-lg-none" type="button" onclick="document.getElementById('sidebar').classList.toggle('open')"><i class="bi bi-list"></i></button>
                <form class="topbar-search" action="/products" method="get">
                    <i class="bi bi-search"></i>
                    <input name="q" class="form-control form-control-sm" placeholder="Search products by name or barcode…" value="@Context.Request.Query["q"]" />
                </form>
            </header>
            <main class="content">
                @if (TempData["Message"] is string msg)
                {
                    <div class="alert alert-success alert-dismissible fade show"><i class="bi bi-check-circle me-1"></i>@msg<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
                }
                @if (TempData["Error"] is string err)
                {
                    <div class="alert alert-danger alert-dismissible fade show" style="white-space:pre-line"><i class="bi bi-exclamation-triangle me-1"></i>@err<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
                }
                @RenderBody()
            </main>
        </div>
    </div>
    <datalist id="product-options"></datalist>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
