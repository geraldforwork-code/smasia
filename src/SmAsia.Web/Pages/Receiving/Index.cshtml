@page
@model SmAsia.Web.Pages.Receiving.IndexModel
@{ ViewData["Title"] = "Receiving"; }

<div class="page-head">
    <div><h1>Receiving</h1><div class="sub">Supplier deliveries and invoices</div></div>
    <a class="btn btn-primary" href="/receiving/upload"><i class="bi bi-plus-lg"></i> Receive delivery</a>
</div>

<div class="card mb-3"><div class="card-body py-2">
    <form method="get" class="filters">
        <select name="status" class="form-select form-select-sm" onchange="this.form.submit()">
            <option value="">All</option>
            <option value="Draft" selected="@(Model.Status == "Draft")">Draft (to review)</option>
            <option value="Posted" selected="@(Model.Status == "Posted")">Posted</option>
        </select>
        <select name="supplierId" class="form-select form-select-sm" onchange="this.form.submit()">
            <option value="">All suppliers</option>
            @foreach (var s in Model.Suppliers) { <option value="@s.Id" selected="@(s.Id == Model.SupplierId)">@s.Name</option> }
        </select>
    </form>
</div></div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead><tr><th>Received</th><th>Supplier</th><th>Invoice</th><th>Invoice date</th><th>PO</th><th class="num">Lines</th><th class="num">Unmatched</th><th class="num">Invoice total</th><th>Status</th></tr></thead>
            <tbody>
            @foreach (var r in Model.Receipts)
            {
                var unmatched = r.Lines.Count(l => !l.Skip && l.ProductId == null);
                <tr>
                    <td>@Fmt.Date(r.ReceivedDate)</td>
                    <td>@r.Supplier.Name</td>
                    <td><a class="fw-semibold" href="/receiving/edit/@r.Id">@(r.InvoiceNumber ?? $"Receipt #{r.Id}")</a></td>
                    <td>@Fmt.Date(r.InvoiceDate)</td>
                    <td>@if (r.PurchaseOrder != null) {<a href="/purchaseorders/view/@r.PurchaseOrderId">@r.PurchaseOrder.PoNumber</a>}</td>
                    <td class="num">@r.Lines.Count</td>
                    <td class="num">@if (unmatched > 0 && r.Status == ReceiptStatus.Draft) {@Fmt.Badge(unmatched.ToString(), "warn")}</td>
                    <td class="num">@Fmt.Money(r.InvoiceTotal ?? r.LinesTotal)</td>
                    <td>@(r.Status == ReceiptStatus.Posted ? Fmt.Badge("Posted", "ok") : Fmt.Badge("Draft", "warn"))</td>
                </tr>
            }
            @if (Model.Receipts.Count == 0) { <tr><td colspan="9" class="muted p-3">No receipts yet. <a href="/receiving/upload">Receive a delivery</a>.</td></tr> }
            </tbody>
        </table>
    </div>
</div>
