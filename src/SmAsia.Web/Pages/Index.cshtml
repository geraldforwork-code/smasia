@page
@model IndexModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="page-head">
    <div>
        <h1>Dashboard</h1>
        <div class="sub">@DateTime.Today.ToString("dddd, MMMM d, yyyy")@(Model.LastSalesDate != null ? $" · sales imported through {Fmt.Date(Model.LastSalesDate)}" : "")</div>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-secondary" href="/import/sales"><i class="bi bi-upload"></i> Import EPOS sales</a>
        <a class="btn btn-outline-secondary" href="/receiving/upload"><i class="bi bi-file-earmark-pdf"></i> Receive invoice</a>
        <a class="btn btn-primary" href="/forecast?needsOrder=true"><i class="bi bi-cart-plus"></i> Reorder</a>
    </div>
</div>

@if (Model.ProductCount == 0)
{
    <div class="card mb-3"><div class="card-body">
        <h5 class="mb-2">Getting started</h5>
        <ol class="mb-0">
            <li><a href="/import/inventory">Import your inventory workbook</a> to load products, locations, expiry dates and counts.</li>
            <li><a href="/receiving/upload">Upload a supplier invoice PDF</a> (UNO Foods or Dong Phuong) to receive stock and learn supplier item codes.</li>
            <li><a href="/import/sales">Import EPOS sales reports</a> so the forecast can calculate reorder quantities.</li>
        </ol>
    </div></div>
}

<div class="row g-3 mb-3">
    <div class="col-6 col-xl-2"><div class="card kpi"><div class="label">Products</div><div class="value">@Model.ProductCount.ToString("N0")</div><div class="hint">@Model.OutOfStock out of stock</div></div></div>
    <div class="col-6 col-xl-2"><div class="card kpi"><div class="label">Stock value</div><div class="value">@Model.StockValue.ToString("C0")</div><div class="hint">at average cost</div></div></div>
    <div class="col-6 col-xl-2"><a class="card kpi text-decoration-none text-reset" href="/forecast?needsOrder=true"><div class="label">Need reorder</div><div class="value @(Model.ReorderCount > 0 ? "text-danger" : "")">@Model.ReorderCount</div><div class="hint">below reorder point</div></a></div>
    <div class="col-6 col-xl-2"><a class="card kpi text-decoration-none text-reset" href="/purchaseorders"><div class="label">Open POs</div><div class="value">@Model.OpenPoCount</div><div class="hint">@Model.OpenPoValue.ToString("C0") on order</div></a></div>
    <div class="col-6 col-xl-2"><a class="card kpi text-decoration-none text-reset" href="/products?filter=expiring"><div class="label">Expired / ≤ 60 days</div><div class="value @(Model.ExpiringCount > 0 ? "text-warning" : "")">@Model.ExpiringCount</div><div class="hint">items in stock</div></a></div>
    <div class="col-6 col-xl-2"><div class="card kpi"><div class="label">Sales, last 28 days</div><div class="value">@Model.Sales28Amount.ToString("C0")</div><div class="hint">@Fmt.Qty(Model.Sales28Units) units</div></div></div>
</div>

<div class="row g-3">
    <div class="col-xl-7">
        <div class="card h-100">
            <div class="card-header">Weekly sales (last 12 weeks)</div>
            <div class="card-body">
                @if (Model.WeeklySales.Count == 0)
                {
                    <p class="muted mb-0">No sales imported yet. <a href="/import/sales">Import an EPOS sales report</a>.</p>
                }
                else
                {
                    <canvas id="salesChart" height="110"></canvas>
                }
            </div>
        </div>
    </div>
    <div class="col-xl-5">
        <div class="card h-100">
            <div class="card-header d-flex justify-content-between">Reorder now <a class="small" href="/forecast?needsOrder=true">All suggestions →</a></div>
            <div class="table-responsive">
                <table class="table table-sm table-hover">
                    <thead><tr><th>Product</th><th class="num">On hand</th><th class="num">Days left</th><th class="num">Order</th></tr></thead>
                    <tbody>
                    @foreach (var r in Model.Reorder)
                    {
                        <tr>
                            <td><a href="/products/details/@r.Product.Id">@r.Product.Name</a><div class="small-muted">@(r.Supplier?.Name ?? "No supplier")</div></td>
                            <td class="num">@Fmt.Qty(r.Product.QtyOnHand)</td>
                            <td class="num">@(r.Advice.DaysOfCover is { } d ? d.ToString("0") : "—")</td>
                            <td class="num">@Fmt.Qty(r.Advice.SuggestedCases) cs</td>
                        </tr>
                    }
                    @if (Model.Reorder.Count == 0)
                    {
                        <tr><td colspan="4" class="muted">Nothing needs reordering.</td></tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="col-xl-4">
        <div class="card h-100">
            <div class="card-header d-flex justify-content-between">Expired &amp; expiring soon <a class="small" href="/products?filter=expiring&sort=expiry">All →</a></div>
            <table class="table table-sm">
                <tbody>
                @foreach (var p in Model.Expiring)
                {
                    <tr><td><a href="/products/details/@p.Id">@p.Name</a><div class="small-muted">@p.Location</div></td><td class="num">@Fmt.Qty(p.QtyOnHand)</td><td class="num">@Fmt.Expiry(p.NearestExpiry)</td></tr>
                }
                @if (Model.Expiring.Count == 0) { <tr><td class="muted">Nothing expiring in the next 60 days.</td></tr> }
                </tbody>
            </table>
        </div>
    </div>
    <div class="col-xl-4">
        <div class="card h-100">
            <div class="card-header d-flex justify-content-between">Recent receipts <a class="small" href="/receiving">All →</a></div>
            <table class="table table-sm">
                <tbody>
                @foreach (var r in Model.RecentReceipts)
                {
                    <tr>
                        <td><a href="/receiving/edit/@r.Id">@r.Supplier.Name</a><div class="small-muted">@(r.InvoiceNumber ?? $"Receipt #{r.Id}") · @Fmt.Date(r.ReceivedDate)</div></td>
                        <td class="num">@Fmt.Money(r.InvoiceTotal)</td>
                        <td class="num">@(r.Status == ReceiptStatus.Posted ? Fmt.Badge("Posted", "ok") : Fmt.Badge("Draft", "warn"))</td>
                    </tr>
                }
                @if (Model.RecentReceipts.Count == 0) { <tr><td class="muted">No receipts yet.</td></tr> }
                </tbody>
            </table>
        </div>
    </div>
    <div class="col-xl-4">
        <div class="card h-100">
            <div class="card-header d-flex justify-content-between">Recent imports <a class="small" href="/import">All →</a></div>
            <table class="table table-sm">
                <tbody>
                @foreach (var b in Model.RecentImports)
                {
                    <tr>
                        <td><a href="/import/batch/@b.Id">@b.FileName</a><div class="small-muted">@b.Type · @b.ImportedAt.ToString("g")</div></td>
                        <td class="num">@if (b.Reversed) {@Fmt.Badge("Reversed", "neutral")} else {<text>@b.RowsImported rows </text>@if (b.RowsUnmatched > 0) {@Fmt.Badge($"{b.RowsUnmatched} unmatched", "warn")}}</td>
                    </tr>
                }
                @if (Model.RecentImports.Count == 0) { <tr><td class="muted">No imports yet.</td></tr> }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    @if (Model.WeeklySales.Count > 0)
    {
        <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
        <script>
            new Chart(document.getElementById('salesChart'), {
                type: 'bar',
                data: {
                    labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.WeeklySales.Select(w => w.Week.ToString("MMM d")))),
                    datasets: [{ label: 'Net sales', data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.WeeklySales.Select(w => Math.Round(w.Amount, 2)))), backgroundColor: '#0f766e', borderRadius: 4 }]
                },
                options: {
                    plugins: { legend: { display: false }, tooltip: { callbacks: { label: c => ' $' + c.parsed.y.toLocaleString(undefined, { minimumFractionDigits: 2 }) } } },
                    scales: { y: { beginAtZero: true, ticks: { callback: v => '$' + v.toLocaleString() } }, x: { grid: { display: false } } }
                }
            });
        </script>
    }
}
