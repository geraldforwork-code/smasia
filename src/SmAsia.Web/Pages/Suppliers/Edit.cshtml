@page "{id:int?}"
@model SmAsia.Web.Pages.Suppliers.EditModel
@{
    var isNew = Model.Supplier.Id == 0;
    ViewData["Title"] = isNew ? "New supplier" : Model.Supplier.Name;
}

<div class="page-head"><h1>@(isNew ? "New supplier" : Model.Supplier.Name)</h1></div>

<div class="row g-3">
    <div class="col-xl-6">
        <form method="post" class="card">
            <div class="card-body">
                <input type="hidden" asp-for="Supplier.Id" />
                <div class="row g-3">
                    <div class="col-md-8"><label class="form-label" asp-for="Supplier.Name">Name</label><input class="form-control" asp-for="Supplier.Name" /><span asp-validation-for="Supplier.Name" class="text-danger small"></span></div>
                    <div class="col-md-4"><label class="form-label" asp-for="Supplier.AccountNumber">Our account #</label><input class="form-control" asp-for="Supplier.AccountNumber" /></div>
                    <div class="col-md-6"><label class="form-label" asp-for="Supplier.ContactName">Contact</label><input class="form-control" asp-for="Supplier.ContactName" /></div>
                    <div class="col-md-6"><label class="form-label" asp-for="Supplier.Phone">Phone</label><input class="form-control" asp-for="Supplier.Phone" /></div>
                    <div class="col-md-6"><label class="form-label" asp-for="Supplier.Email">Email</label><input class="form-control" asp-for="Supplier.Email" /><span asp-validation-for="Supplier.Email" class="text-danger small"></span></div>
                    <div class="col-md-6"><label class="form-label" asp-for="Supplier.Terms">Payment terms</label><input class="form-control" asp-for="Supplier.Terms" /></div>
                    <div class="col-12"><label class="form-label" asp-for="Supplier.Address">Address</label><input class="form-control" asp-for="Supplier.Address" /></div>
                    <div class="col-md-4">
                        <label class="form-label" asp-for="Supplier.LeadTimeDays">Lead time (days)</label><input class="form-control" asp-for="Supplier.LeadTimeDays" type="number" min="0" />
                        <div class="form-text">Order to delivery.</div>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label" asp-for="Supplier.OrderCycleDays">Order every (days)</label><input class="form-control" asp-for="Supplier.OrderCycleDays" type="number" min="1" />
                        <div class="form-text">Each order should last this long.</div>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Invoice PDF format</label>
                        <select class="form-select" asp-for="Supplier.InvoiceParserKey">
                            <option value="">None (enter manually)</option>
                            @foreach (var p in Model.Parsers) { <option value="@p.Key">@p.SupplierName</option> }
                        </select>
                    </div>
                    <div class="col-12"><label class="form-label" asp-for="Supplier.Notes">Notes</label><textarea class="form-control" asp-for="Supplier.Notes" rows="2"></textarea></div>
                    <div class="col-12"><div class="form-check"><input class="form-check-input" asp-for="Supplier.IsActive" /><label class="form-check-label" asp-for="Supplier.IsActive">Active</label></div></div>
                </div>
            </div>
            <div class="card-footer d-flex gap-2"><button class="btn btn-primary">Save</button><a class="btn btn-link" href="/suppliers">Cancel</a></div>
        </form>
    </div>
    @if (!isNew)
    {
        <div class="col-xl-6">
            <div class="card">
                <div class="card-header">Item codes (@Model.Items.Count)</div>
                <div class="table-responsive" style="max-height: 600px">
                    <table class="table table-sm">
                        <thead><tr><th>Code</th><th>Product</th><th class="num">Units/cs</th><th class="num">Last cost/cs</th><th>Last received</th></tr></thead>
                        <tbody>
                        @foreach (var i in Model.Items)
                        {
                            <tr><td class="fw-semibold">@i.SupplierItemCode</td><td><a href="/products/details/@i.ProductId">@i.Product.Name</a></td><td class="num">@i.UnitsPerCase</td><td class="num">@Fmt.Money(i.LastCaseCost)</td><td>@Fmt.Date(i.LastReceivedOn)</td></tr>
                        }
                        @if (Model.Items.Count == 0) { <tr><td colspan="5" class="muted">Item codes are learned when invoices from this supplier are received.</td></tr> }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
