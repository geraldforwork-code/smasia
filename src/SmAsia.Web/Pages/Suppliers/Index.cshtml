@page
@model SmAsia.Web.Pages.Suppliers.IndexModel
@{ ViewData["Title"] = "Suppliers"; }

<div class="page-head">
    <div><h1>Suppliers</h1><div class="sub">Lead time and order cycle drive the reorder calculation.</div></div>
    <a class="btn btn-primary" href="/suppliers/edit"><i class="bi bi-plus-lg"></i> New supplier</a>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead><tr><th>Supplier</th><th>Account</th><th>Phone</th><th>Terms</th><th class="num">Lead time</th><th class="num">Order every</th><th>Invoice import</th><th class="num">Products</th><th class="num">Open POs</th><th>Last received</th></tr></thead>
            <tbody>
            @foreach (var r in Model.Rows)
            {
                var s = r.Supplier;
                <tr class="@(s.IsActive ? "" : "row-skip")">
                    <td><a class="fw-semibold" href="/suppliers/edit/@s.Id">@s.Name</a></td>
                    <td>@s.AccountNumber</td>
                    <td>@s.Phone</td>
                    <td class="small">@s.Terms</td>
                    <td class="num">@s.LeadTimeDays d</td>
                    <td class="num">@s.OrderCycleDays d</td>
                    <td>@(s.InvoiceParserKey != null ? Fmt.Badge("PDF", "ok") : Fmt.Badge("Manual", "neutral"))</td>
                    <td class="num"><a href="/products?supplierId=@s.Id">@r.Products</a></td>
                    <td class="num">@r.OpenPos</td>
                    <td>@Fmt.Date(r.LastReceipt)</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
