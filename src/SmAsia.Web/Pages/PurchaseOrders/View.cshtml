@page "{id:int}"
@model SmAsia.Web.Pages.PurchaseOrders.ViewModel
@{
    var po = Model.Po;
    ViewData["Title"] = po.PoNumber;
}

<div class="page-head d-print-none">
    <div><h1>@po.PoNumber @Fmt.PoStatus(po.Status)</h1><div class="sub">@po.Supplier.Name</div></div>
    <div class="d-flex flex-wrap gap-2">
        <button class="btn btn-outline-secondary" onclick="window.print()"><i class="bi bi-printer"></i> Print / PDF</button>
        @if (po.Status == PurchaseOrderStatus.Draft)
        {
            <a class="btn btn-outline-secondary" href="/purchaseorders/edit/@po.Id"><i class="bi bi-pencil"></i> Edit</a>
            <form method="post" asp-page-handler="Delete" asp-route-id="@po.Id"><button class="btn btn-outline-danger" data-confirm="Delete this draft PO?"><i class="bi bi-trash"></i></button></form>
            <form method="post" asp-page-handler="Status" asp-route-id="@po.Id" asp-route-status="Sent"><button class="btn btn-primary"><i class="bi bi-send"></i> Mark as sent</button></form>
        }
        @if (po.Status is PurchaseOrderStatus.Sent or PurchaseOrderStatus.PartiallyReceived)
        {
            <form method="post" asp-page-handler="Receive" asp-route-id="@po.Id"><button class="btn btn-primary"><i class="bi bi-box-arrow-in-down"></i> Receive</button></form>
            <a class="btn btn-outline-primary" href="/receiving/upload?poId=@po.Id"><i class="bi bi-file-earmark-pdf"></i> Receive from invoice PDF</a>
        }
        @if (po.Status == PurchaseOrderStatus.Sent)
        {
            <form method="post" asp-page-handler="Status" asp-route-id="@po.Id" asp-route-status="Draft"><button class="btn btn-outline-secondary">Back to draft</button></form>
        }
        @if (po.IsOpen)
        {
            <form method="post" asp-page-handler="Status" asp-route-id="@po.Id" asp-route-status="Cancelled"><button class="btn btn-outline-danger" data-confirm="Cancel this purchase order?">Cancel PO</button></form>
        }
        @if (po.Status == PurchaseOrderStatus.PartiallyReceived)
        {
            <form method="post" asp-page-handler="Status" asp-route-id="@po.Id" asp-route-status="Received"><button class="btn btn-outline-secondary" data-confirm="Close this PO? Outstanding quantities will no longer count as on order.">Close (short shipped)</button></form>
        }
    </div>
</div>

<div class="card">
    <div class="card-body">
        <div class="d-flex justify-content-between flex-wrap mb-4">
            <div>
                <h4 class="mb-1">SM Asia Enterprises</h4>
                <div class="muted">Purchase Order</div>
            </div>
            <div class="text-end">
                <div class="fs-5 fw-bold">@po.PoNumber</div>
                <div>Date: @Fmt.Date(po.OrderDate)</div>
                <div>Expected: @Fmt.Date(po.ExpectedDate)</div>
            </div>
        </div>
        <div class="mb-4">
            <div class="small-muted text-uppercase">Supplier</div>
            <div class="fw-semibold">@po.Supplier.Name</div>
            @if (po.Supplier.AccountNumber != null) { <div>Account: @po.Supplier.AccountNumber</div> }
            <div>@po.Supplier.Address</div>
            <div>@po.Supplier.Phone @po.Supplier.Email</div>
        </div>
        <table class="table table-sm">
            <thead><tr><th>Item code</th><th>Description</th><th>Barcode</th><th class="num">Cases</th><th class="num">Pack</th><th class="num">Cost/cs</th><th class="num">Amount</th>@if (po.Status != PurchaseOrderStatus.Draft) {<th class="num d-print-none">Received</th>}</tr></thead>
            <tbody>
            @foreach (var l in po.Lines.OrderBy(l => l.SupplierItemCode ?? l.Product.Name))
            {
                <tr>
                    <td>@l.SupplierItemCode</td>
                    <td>@l.Product.Name</td>
                    <td class="small">@l.Product.Barcode</td>
                    <td class="num">@Fmt.Qty(l.QtyCases)</td>
                    <td class="num">@l.UnitsPerCase</td>
                    <td class="num">@Fmt.Money(l.CaseCost)</td>
                    <td class="num">@Fmt.Money(l.QtyCases * l.CaseCost)</td>
                    @if (po.Status != PurchaseOrderStatus.Draft) { <td class="num d-print-none">@Fmt.Qty(l.QtyReceivedUnits) / @Fmt.Qty(l.QtyOrderedUnits)</td> }
                </tr>
            }
            </tbody>
            <tfoot>
                <tr class="fw-semibold"><td colspan="3" class="num">Total</td><td class="num">@Fmt.Qty(po.Lines.Sum(l => l.QtyCases))</td><td></td><td></td><td class="num">@Fmt.Money(po.Total)</td>@if (po.Status != PurchaseOrderStatus.Draft) {<td class="d-print-none"></td>}</tr>
            </tfoot>
        </table>
        @if (!string.IsNullOrWhiteSpace(po.Notes)) { <p class="mt-3"><strong>Notes:</strong> @po.Notes</p> }
    </div>
</div>

@if (Model.Receipts.Count > 0)
{
    <div class="card mt-3 d-print-none">
        <div class="card-header">Receipts against this PO</div>
        <table class="table table-sm">
            @foreach (var r in Model.Receipts)
            {
                <tr><td><a href="/receiving/edit/@r.Id">@(r.InvoiceNumber ?? $"Receipt #{r.Id}")</a></td><td>@Fmt.Date(r.ReceivedDate)</td><td>@(r.Status == ReceiptStatus.Posted ? Fmt.Badge("Posted", "ok") : Fmt.Badge("Draft", "warn"))</td></tr>
            }
        </table>
    </div>
}
