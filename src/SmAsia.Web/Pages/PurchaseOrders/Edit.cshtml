@page "{id:int?}"
@model SmAsia.Web.Pages.PurchaseOrders.EditModel
@{
    ViewData["Title"] = Model.Id == 0 ? "New purchase order" : Model.PoNumber;
    var total = Model.Lines.Sum(l => l.QtyCases * l.CaseCost);
}

<div class="page-head">
    <div><h1>@(Model.Id == 0 ? "New purchase order" : $"Edit {Model.PoNumber}")</h1><div class="sub">Draft — not yet sent to the supplier</div></div>
    @if (Model.Id != 0) { <a class="btn btn-outline-secondary" href="/purchaseorders/view/@Model.Id"><i class="bi bi-eye"></i> View / send</a> }
</div>

<form method="post">
    <input type="hidden" asp-for="Id" />
    <div class="card mb-3"><div class="card-body">
        <div class="row g-3">
            <div class="col-md-4">
                <label class="form-label">Supplier</label>
                <select class="form-select" asp-for="SupplierId" required>
                    <option value="0">Choose…</option>
                    @foreach (var s in Model.Suppliers) { <option value="@s.Id">@s.Name</option> }
                </select>
            </div>
            <div class="col-md-2"><label class="form-label">Order date</label><input class="form-control" asp-for="OrderDate" type="date" /></div>
            <div class="col-md-2"><label class="form-label">Expected</label><input class="form-control" asp-for="ExpectedDate" type="date" /></div>
            <div class="col-md-4"><label class="form-label">Notes</label><input class="form-control" asp-for="Notes" /></div>
        </div>
    </div></div>

    <div class="card">
        <div class="table-responsive">
            <table class="table table-sm align-middle">
                <thead><tr><th>Product</th><th>Supplier code</th><th class="num">On hand</th><th class="num" style="width:110px">Cases</th><th class="num" style="width:100px">Units/cs</th><th class="num" style="width:120px">Cost/cs</th><th class="num">Line total</th><th>Remove</th></tr></thead>
                <tbody>
                @for (int i = 0; i < Model.Lines.Count; i++)
                {
                    var l = Model.Lines[i];
                    <tr>
                        <td>
                            <input type="hidden" asp-for="Lines[i].Id" /><input type="hidden" asp-for="Lines[i].ProductId" /><input type="hidden" asp-for="Lines[i].ProductName" /><input type="hidden" asp-for="Lines[i].QtyOnHand" />
                            <a href="/products/details/@l.ProductId">@l.ProductName</a>
                        </td>
                        <td><input class="form-control form-control-sm" asp-for="Lines[i].SupplierItemCode" style="width:110px" /></td>
                        <td class="num">@Fmt.Qty(l.QtyOnHand)</td>
                        <td><input class="form-control form-control-sm text-end" asp-for="Lines[i].QtyCases" type="number" step="any" min="0" /></td>
                        <td><input class="form-control form-control-sm text-end" asp-for="Lines[i].UnitsPerCase" type="number" min="1" /></td>
                        <td><input class="form-control form-control-sm text-end" asp-for="Lines[i].CaseCost" type="number" step="0.01" min="0" /></td>
                        <td class="num">@Fmt.Money(l.QtyCases * l.CaseCost)</td>
                        <td class="text-center"><input class="form-check-input" type="checkbox" asp-for="Lines[i].Remove" /></td>
                    </tr>
                }
                <tr class="table-light">
                    <td colspan="3">
                        <input class="form-control form-control-sm product-picker" placeholder="Add product — type a name or barcode…" data-target="#AddProductId" />
                        <input type="hidden" asp-for="AddProductId" id="AddProductId" />
                    </td>
                    <td><input class="form-control form-control-sm text-end" asp-for="AddCases" type="number" step="any" min="0" placeholder="1" /></td>
                    <td colspan="4"><button class="btn btn-sm btn-outline-primary"><i class="bi bi-plus"></i> Add</button></td>
                </tr>
                </tbody>
                <tfoot><tr class="fw-semibold"><td colspan="6" class="num">Total</td><td class="num">@Fmt.Money(total)</td><td></td></tr></tfoot>
            </table>
        </div>
        <div class="sticky-actions d-flex gap-2">
            <button class="btn btn-primary" name="then" value="edit">Save draft</button>
            <button class="btn btn-outline-primary" name="then" value="view">Save &amp; view</button>
            <a class="btn btn-link" href="/purchaseorders">Back</a>
        </div>
    </div>
</form>
