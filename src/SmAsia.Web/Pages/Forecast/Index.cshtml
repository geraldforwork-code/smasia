@page
@model SmAsia.Web.Pages.Forecast.IndexModel
@{
    ViewData["Title"] = "Forecast & reorder";
    var suggested = Model.Rows.Count(r => r.Advice.SuggestedUnits > 0);
    var suggestedValue = Model.Rows.Where(r => r.Advice.SuggestedUnits > 0).Sum(r => r.Advice.SuggestedUnits * r.Product.UnitCost);
}

<div class="page-head">
    <div>
        <h1>Forecast &amp; reorder</h1>
        <div class="sub">
            @if (Model.SalesRange is { } sr)
            {
                <span>Based on sales @Fmt.Date(sr.First) – @Fmt.Date(sr.Last) (up to @Model.Settings.LookbackDays days), @Model.Settings.ServiceLevel.ToString("P0") service level.</span>
            }
            else
            {
                <span>No sales imported yet — only minimum-stock rules apply. <a href="/import/sales">Import EPOS sales</a>.</span>
            }
        </div>
    </div>
</div>

<div class="card mb-3"><div class="card-body py-2">
    <form method="get" class="filters">
        <input class="form-control form-control-sm" name="q" value="@Model.Q" placeholder="Search product" />
        <select name="supplierId" class="form-select form-select-sm">
            <option value="">All suppliers</option>
            @foreach (var s in Model.Suppliers) { <option value="@s.Id" selected="@(s.Id == Model.SupplierId)">@s.Name</option> }
        </select>
        <select name="categoryId" class="form-select form-select-sm">
            <option value="">All categories</option>
            @foreach (var c in Model.Categories) { <option value="@c.Id" selected="@(c.Id == Model.CategoryId)">@c.Name</option> }
        </select>
        <select name="sort" class="form-select form-select-sm">
            <option value="cover">Sort: most urgent</option>
            <option value="demand" selected="@(Model.Sort == "demand")">Sort: fastest selling</option>
            <option value="supplier" selected="@(Model.Sort == "supplier")">Sort: supplier</option>
            <option value="name" selected="@(Model.Sort == "name")">Sort: name</option>
        </select>
        <div class="form-check ms-2"><input class="form-check-input" type="checkbox" name="needsOrder" value="true" id="needs" checked="@Model.NeedsOrder" /><label class="form-check-label" for="needs">Only items to reorder</label></div>
        <button class="btn btn-sm btn-primary">Apply</button>
    </form>
</div></div>

<form method="post" asp-route-supplierId="@Model.SupplierId" asp-route-categoryId="@Model.CategoryId" asp-route-needsOrder="@Model.NeedsOrder" asp-route-q="@Model.Q" asp-route-sort="@Model.Sort">
<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span>@Model.Rows.Count products · <span class="text-danger">@suggested to reorder</span>@(suggestedValue > 0 ? $" (≈ {suggestedValue:C0} at cost)" : "")</span>
    </div>
    <div class="table-responsive">
        <table class="table table-sm table-hover align-middle">
            <thead><tr>
                <th><input type="checkbox" class="form-check-input" data-check-all=".row-check" title="Select all" /></th>
                <th>Product</th><th>Supplier</th>
                <th class="num">On hand</th><th class="num">On order</th>
                <th class="num" title="Units sold in the last 7 / 28 days of imported sales">Sold 7d / 28d</th>
                <th class="num" title="Forecast units per day">Per day</th>
                <th class="num">Trend</th>
                <th class="num">Days left</th>
                <th class="num" title="Reorder when stock + on order falls to this">Reorder pt</th>
                <th>Status</th>
                <th class="num" style="width:95px">Order cs</th>
            </tr></thead>
            <tbody>
            @for (int i = 0; i < Model.Rows.Count; i++)
            {
                var r = Model.Rows[i];
                var urgent = r.Advice.SuggestedUnits > 0;
                <tr>
                    <td>
                        <input type="checkbox" class="form-check-input row-check" asp-for="Orders[i].Selected" />
                        <input type="hidden" asp-for="Orders[i].ProductId" /><input type="hidden" asp-for="Orders[i].SupplierId" />
                    </td>
                    <td><a href="/products/details/@r.Product.Id">@r.Product.Name</a><div class="small-muted">@r.Product.UnitsPerCase/cs · @r.Forecast.Method</div></td>
                    <td class="small">@(r.Supplier?.Name ?? "—")</td>
                    <td class="num @(r.Product.QtyOnHand <= 0 ? "text-danger fw-semibold" : "")">@Fmt.Qty(r.Product.QtyOnHand)</td>
                    <td class="num">@(r.OnOrder > 0 ? Fmt.Qty(r.OnOrder) : "")</td>
                    <td class="num">@Fmt.Qty(r.Forecast.Sold7) / @Fmt.Qty(r.Forecast.Sold28)</td>
                    <td class="num">@r.Forecast.DailyRate.ToString("0.##")</td>
                    <td class="num">@if (r.Forecast.Trend is { } t && Math.Abs(t) >= 0.02) {<span class="@(t > 0 ? "text-success" : "text-danger")"><i class="bi bi-arrow-@(t > 0 ? "up" : "down")-right"></i>@Math.Abs(t).ToString("P0")</span>}</td>
                    <td class="num">@(r.Advice.DaysOfCover is { } d ? d.ToString("0") : "—")</td>
                    <td class="num">@r.Advice.ReorderPoint.ToString("0")</td>
                    <td>@if (urgent) {@Fmt.Badge(r.Advice.Reason, r.Product.QtyOnHand <= 0 ? "bad" : "warn")} else {<span class="small-muted">@r.Advice.Reason</span>}</td>
                    <td><input class="form-control form-control-sm text-end" asp-for="Orders[i].Cases" type="number" step="1" min="0" /></td>
                </tr>
            }
            @if (Model.Rows.Count == 0) { <tr><td colspan="12" class="muted p-3">Nothing to show.</td></tr> }
            </tbody>
        </table>
    </div>
    <div class="sticky-actions d-flex flex-wrap gap-2 align-items-center">
        <button class="btn btn-primary"><i class="bi bi-cart-plus"></i> Create draft POs for selected</button>
        <span class="small-muted">One PO per supplier.</span>
        <span class="ms-auto d-flex gap-2 align-items-center small">For items with no supplier use
            <select class="form-select form-select-sm" asp-for="FallbackSupplierId" style="width:auto">
                <option value="">—</option>
                @foreach (var s in Model.Suppliers) { <option value="@s.Id">@s.Name</option> }
            </select>
        </span>
    </div>
</div>
</form>

<div class="card mt-3"><div class="card-body small">
    <strong>How suggestions are calculated.</strong>
    Daily demand comes from imported EPOS sales. With 6+ weeks of history it uses a damped-trend model (Holt's exponential smoothing on weekly totals); with less history it uses the average.
    Safety stock = z × weekly variability × √((lead time + order cycle) ÷ 7).
    When stock on hand plus stock on order drops to the <em>reorder point</em> (demand over the lead time + safety stock), it suggests enough whole cases to cover the lead time and order cycle.
    Lead time and order cycle come from each supplier's settings. Minimum stock on a product always applies.
</div></div>
