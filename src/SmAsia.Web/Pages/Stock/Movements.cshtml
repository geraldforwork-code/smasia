@page
@model SmAsia.Web.Pages.Stock.MovementsModel
@{ ViewData["Title"] = "Stock movements"; }

<div class="page-head"><div><h1>Stock movements</h1><div class="sub">Every change to stock: receipts, sales, counts and adjustments.</div></div></div>

<div class="card mb-3"><div class="card-body py-2">
    <form method="get" class="filters">
        <input class="form-control form-control-sm" name="q" value="@Model.Q" placeholder="Product or reference" />
        <select name="type" class="form-select form-select-sm">
            <option value="">All types</option>
            @foreach (var t in Enum.GetValues<MovementType>()) { <option value="@t" selected="@(t == Model.Type)">@t</option> }
        </select>
        <input class="form-control form-control-sm" type="date" name="from" value="@Model.From?.ToString("yyyy-MM-dd")" />
        <input class="form-control form-control-sm" type="date" name="to" value="@Model.To?.ToString("yyyy-MM-dd")" />
        <button class="btn btn-sm btn-primary">Filter</button>
    </form>
</div></div>

<div class="card">
    <div class="card-header small">@Model.Items.Count movements@(Model.ValueIn > 0 ? $" · {Model.ValueIn:C} received" : "")@(Model.Items.Count == 1000 ? " (showing latest 1,000)" : "")</div>
    <div class="table-responsive">
        <table class="table table-sm table-hover">
            <thead><tr><th>Date</th><th>Product</th><th>Type</th><th>Reference</th><th class="num">Change</th><th class="num">Balance</th><th class="num">Unit cost</th></tr></thead>
            <tbody>
            @foreach (var m in Model.Items)
            {
                <tr>
                    <td class="small">@m.OccurredAt.ToString("g")</td>
                    <td><a href="/products/details/@m.ProductId">@m.Product.Name</a></td>
                    <td>@m.Type</td>
                    <td class="small">@m.Reference <span class="muted">@m.Note</span></td>
                    <td class="num @Fmt.MovementClass(m.Quantity)">@(m.Quantity > 0 ? "+" : "")@Fmt.Qty(m.Quantity)</td>
                    <td class="num">@Fmt.Qty(m.QtyAfter)</td>
                    <td class="num">@(m.UnitCost != null ? Fmt.Money(m.UnitCost.Value) : "")</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
