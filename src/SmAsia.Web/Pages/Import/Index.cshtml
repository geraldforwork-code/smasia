@page
@model SmAsia.Web.Pages.Import.IndexModel
@{ ViewData["Title"] = "Imports"; }

<div class="page-head"><div><h1>Imports</h1><div class="sub">Bring data in from the EPOS, spreadsheets and supplier invoices.</div></div></div>

<div class="row g-3 mb-3">
    <div class="col-md-4">
        <a class="card h-100 text-decoration-none text-reset" href="/import/sales"><div class="card-body">
            <h5><i class="bi bi-receipt text-brand"></i> EPOS sales report</h5>
            <p class="small-muted mb-0">CSV or Excel export of product sales from the till. Feeds the forecast and deducts stock.</p>
        </div></a>
    </div>
    <div class="col-md-4">
        <a class="card h-100 text-decoration-none text-reset" href="/import/inventory"><div class="card-body">
            <h5><i class="bi bi-table text-brand"></i> Inventory workbook</h5>
            <p class="small-muted mb-0">Products, categories, locations, expiry dates and stock counts from a spreadsheet.</p>
        </div></a>
    </div>
    <div class="col-md-4">
        <a class="card h-100 text-decoration-none text-reset" href="/receiving/upload"><div class="card-body">
            <h5><i class="bi bi-file-earmark-pdf text-danger"></i> Supplier invoice PDF</h5>
            <p class="small-muted mb-0">UNO Foods and Dong Phuong invoices, read line by line into a receipt.</p>
        </div></a>
    </div>
</div>

@if (Model.OpenIssues > 0)
{
    <div class="alert alert-warning"><i class="bi bi-exclamation-triangle"></i> @Model.OpenIssues sales rows from earlier imports aren't linked to a product yet. Open the import below to link them.</div>
}

<div class="card">
    <div class="card-header">History</div>
    <div class="table-responsive">
        <table class="table table-sm table-hover align-middle">
            <thead><tr><th>Imported</th><th>Type</th><th>File</th><th>Period</th><th class="num">Rows read</th><th class="num">Imported</th><th class="num">Unmatched</th><th class="num">Skipped</th><th></th></tr></thead>
            <tbody>
            @foreach (var b in Model.Batches)
            {
                <tr class="@(b.Reversed ? "row-skip" : "")">
                    <td class="small">@b.ImportedAt.ToString("g")</td>
                    <td>@b.Type</td>
                    <td><a href="/import/batch/@b.Id">@b.FileName</a></td>
                    <td class="small">@(b.PeriodFrom != null ? $"{Fmt.Date(b.PeriodFrom)} – {Fmt.Date(b.PeriodTo)}" : "")</td>
                    <td class="num">@b.RowsRead</td>
                    <td class="num">@b.RowsImported</td>
                    <td class="num">@if (b.RowsUnmatched > 0 && !b.Reversed) {@Fmt.Badge(b.RowsUnmatched.ToString(), "warn")}</td>
                    <td class="num">@b.RowsSkipped</td>
                    <td>@if (b.Reversed) {@Fmt.Badge("Reversed", "neutral")}</td>
                </tr>
            }
            @if (Model.Batches.Count == 0) { <tr><td colspan="9" class="muted p-3">Nothing imported yet.</td></tr> }
            </tbody>
        </table>
    </div>
</div>
