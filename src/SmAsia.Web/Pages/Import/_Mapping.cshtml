@model SmAsia.Web.Pages.Import.MappingView
@{
    var cols = Model.ColumnCount;
    var mappedCols = Model.Map.GroupBy(kv => kv.Value)
        .ToDictionary(g => g.Key, g => string.Join(", ", g.Select(kv => Model.Fields.FirstOrDefault(f => f.Key == kv.Key)?.Label)));
}
<div class="card mb-3">
    <div class="card-header d-flex justify-content-between flex-wrap gap-2">
        <span>Match columns @if (Model.FromSavedProfile) { @Fmt.Badge("Using saved mapping for this report layout", "info") }</span>
        <span class="small-muted">@Model.OriginalName · @Model.File.Rows.Count rows@(Model.File.Sheet != null ? $" · sheet \"{Model.File.Sheet}\"" : "")</span>
    </div>
    <div class="card-body">
        <div class="row g-3">
            @foreach (var f in Model.Fields)
            {
                var current = Model.Map.TryGetValue(f.Key, out var c) ? c : -1;
                <div class="col-md-4 col-xl-3">
                    <label class="form-label mb-1">@f.Label @if (f.Required) {<span class="text-danger">*</span>}</label>
                    <select class="form-select form-select-sm" name="Map[@f.Key]">
                        <option value="-1">— not in this file —</option>
                        @for (int i = 0; i < cols; i++) { <option value="@i" selected="@(i == current)">@Model.ColumnLabel(i)</option> }
                    </select>
                    @if (!string.IsNullOrEmpty(f.Help)) { <div class="form-text">@f.Help</div> }
                </div>
            }
        </div>
    </div>
</div>

<div class="card mb-3">
    <div class="card-header">Preview <span class="small-muted">(header row @(Model.HeaderRow + 1) and the first rows below it)</span></div>
    <div class="table-responsive" style="max-height: 380px">
        <table class="table table-sm table-bordered small mb-0">
            <thead>
                <tr>
                    @for (int i = 0; i < cols; i++)
                    {
                        <th class="@(mappedCols.ContainsKey(i) ? "table-success" : "")">@Model.ColumnLabel(i)@if (mappedCols.TryGetValue(i, out var lbl)) {<div class="text-success text-none" style="text-transform:none">→ @lbl</div>}</th>
                    }
                </tr>
            </thead>
            <tbody>
            @foreach (var row in Model.File.Rows.Skip(Model.HeaderRow + 1).Take(15))
            {
                <tr>@for (int i = 0; i < cols; i++) { <td class="@(mappedCols.ContainsKey(i) ? "table-success" : "")">@(i < row.Length ? row[i] : null)</td> }</tr>
            }
            </tbody>
        </table>
    </div>
</div>
