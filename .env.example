# Copy to .env. Everything is optional: without MSSQL_* the app runs on an in-memory store.
PORT=3000

# Microsoft SQL Server 2022 (either a full connection string or the individual fields)
# MSSQL_CONNECTION_STRING=Server=localhost,1433;Database=StoreInventoryDB;User Id=sa;Password=...;Encrypt=true;TrustServerCertificate=true
MSSQL_HOST=
MSSQL_PORT=1433
MSSQL_DATABASE=StoreInventoryDB
MSSQL_USER=
MSSQL_PASSWORD=
MSSQL_ENCRYPT=true
MSSQL_TRUST_SERVER_CERTIFICATE=true

# Invoice OCR (POST /api/parse-invoice)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Windows authentication (Trusted_Connection) via ODBC Driver 18, e.g. a local named instance:
# MSSQL_HOST=BLANCHARD-PC\SQLEXPRESS
# MSSQL_TRUSTED=true
